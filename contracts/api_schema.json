{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kassa-sentinel.local/schemas/v1/job-response.json",
  "title": "Kassa Sentinel — ответ GET /api/v1/jobs/{job_id}",
  "description": "Обязательные поля — строго по ТЗ (job_id, status, verdict, violations[type, timecode_sec, description, evidence_frames[timestamp_sec, image_base64]]). Дополнительные поля разрешены (additionalProperties: true). Владелец: A01, генерируется contracts.serialize.result_to_api.",
  "type": "object",
  "required": ["job_id", "status", "verdict", "violations"],
  "additionalProperties": true,
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["processing", "done", "failed"]},
    "verdict": {"enum": ["violation", "no_violation", null]},
    "violations": {"type": "array", "items": {"$ref": "#/$defs/Violation"}},
    "progress": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "stage": {"type": ["string", "null"]},
    "error": {"type": ["string", "null"]},
    "timeline": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "number", "minimum": 0},
          {"type": "number", "minimum": 0, "maximum": 1}
        ],
        "minItems": 2
      }
    },
    "meta": {"type": "object", "additionalProperties": true}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "done"}}, "required": ["status"]},
      "then": {"properties": {"verdict": {"enum": ["violation", "no_violation"]}}}
    },
    {
      "if": {"properties": {"status": {"const": "processing"}}, "required": ["status"]},
      "then": {"properties": {"verdict": {"const": null}}}
    }
  ],
  "$defs": {
    "EvidenceFrame": {
      "type": "object",
      "required": ["timestamp_sec", "image_base64"],
      "additionalProperties": true,
      "properties": {
        "timestamp_sec": {"type": "number", "minimum": 0},
        "image_base64": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9+/=]+$"}
      }
    },
    "RuleRef": {
      "type": "object",
      "required": ["document", "url"],
      "additionalProperties": true,
      "properties": {
        "document": {"type": "string"},
        "clause": {"type": ["string", "null"]},
        "url": {"type": "string"},
        "quote": {"type": "string"},
        "verified": {"type": "boolean"}
      }
    },
    "Violation": {
      "type": "object",
      "required": ["type", "timecode_sec", "description", "evidence_frames"],
      "additionalProperties": true,
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "timecode_sec": {"type": "number", "minimum": 0},
        "description": {"type": "string", "minLength": 1},
        "evidence_frames": {"type": "array", "items": {"$ref": "#/$defs/EvidenceFrame"}},
        "type_id": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "t_start": {"type": "number", "minimum": 0},
        "t_end": {"type": "number", "minimum": 0},
        "rules": {"type": "array", "items": {"$ref": "#/$defs/RuleRef"}},
        "rule": {"oneOf": [{"$ref": "#/$defs/RuleRef"}, {"type": "null"}]}
      }
    },
    "AnalyzeResponse": {
      "description": "Ответ POST /api/v1/analyze (multipart поле file, заголовок X-API-Key).",
      "type": "object",
      "required": ["job_id"],
      "additionalProperties": true,
      "properties": {"job_id": {"type": "string", "minLength": 1}}
    },
    "ErrorResponse": {
      "description": "Ошибка (например 401 без верного X-API-Key). Форма FastAPI: {\"detail\": ...}.",
      "type": "object",
      "required": ["detail"],
      "additionalProperties": true
    }
  }
}
