# Kassa Sentinel — .gitignore (владелец A01). Репозиторий публичный.
# Каталоги данных — ТОЛЬКО якорные шаблоны от корня: «data/» без слэша спрятал бы и папки data внутри кода.
# Медиа, веса и файлы > 5 МБ дополнительно блокирует scripts/guard_media.py (pre-commit + CI).
/data/
/weights/
/cache/
/reports/frames/

# Видео и веса — в git никогда (правило 6)
*.mov
*.MOV
*.mp4
*.avi
*.mkv
*.onnx
*.pt
*.pth
*.safetensors
*.gguf
*.engine

node_modules/
frontend/dist/
.env
.venv/
__pycache__/

# Служебные кэши инструментов (не код)
.pytest_cache/
.ruff_cache/
*.egg-info/
