# Kassa Sentinel — переменные окружения (A17). Копия: deploy/.env (в git НЕ попадает: .gitignore).
# Секреты (ключи, TUNNEL_TOKEN, HF_TOKEN) — только в deploy/.env на машине, никогда в репо.
# Пути вида /app/... start.ps1 сам переводит в пути внутри репозитория на Windows.

# --- API (A02) — заданы в ТЗ ---
SENTINEL_API_KEYS=change-me              # через запятую; setup.ps1 генерирует случайный ключ
SENTINEL_WORKERS=1                       # ОДИН GPU-worker (8 GB VRAM); start.ps1 принудительно 1
SENTINEL_PORT=8000
SENTINEL_MAX_UPLOAD_MB=200               # предложено A17 — сверить с A02

# --- пути ---
SENTINEL_DATA_DIR=/app/data
SENTINEL_WEIGHTS=/app/weights
SENTINEL_CACHE_DIR=/app/cache
SENTINEL_LOG_DIR=/app/logs
SENTINEL_FRONTEND_DIST=/app/frontend/dist
HF_HOME=/app/weights/hf
HF_HUB_CACHE=/app/weights/hf/hub

# --- офлайн (рантайм ничего не скачивает) ---
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
SENTINEL_NETGUARD=block                  # block | log | off — запрет сети внутри Python-процесса
SENTINEL_NETGUARD_ALLOW=                 # напр. "llm" для compose; loopback разрешён всегда

# --- пайплайн (A03) — предложено A17, сверить с A03 ---
SENTINEL_MOCK=0                          # 1 = фиктивные модели; НЕ для жюри, offline smoke откажется
SENTINEL_DEVICE=cuda                     # cuda | cpu
SENTINEL_DEADLINE_S=240

# --- туннель (A17) ---
TUNNEL_TOKEN=                            # только для named tunnel (start.ps1 -Named)
CLOUDFLARED_PROTOCOL=                    # пусто = auto; http2, если сеть площадки режет UDP/QUIC

# --- подготовка весов (только setup, не рантайм) ---
HF_TOKEN=                                # если нужен доступ к gated-репозиториям
