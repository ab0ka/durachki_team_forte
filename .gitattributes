# Kassa Sentinel (владелец A01): единые LF-окончания — контракт проверяется по sha256.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Бинарные (в git их быть не должно, см. .gitignore — но на всякий случай без диффов/конвертации)
*.mov binary
*.mp4 binary
*.avi binary
*.jpg binary
*.jpeg binary
*.png binary
*.onnx binary
*.pt binary
*.safetensors binary
*.gguf binary
